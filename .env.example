# =====================================================================
# Nurtura AI — environment variables
# Copy to .env.local for local runs. NEVER commit real keys.
# Demo mode: leave everything below commented — the app serves
# local/mock data and deterministic navigation replies with zero
# external services, and every screen degrades gracefully.
# =====================================================================

# ---- App (public; safe for the browser) ----
NEXT_PUBLIC_APP_NAME="Nurtura AI"
NEXT_PUBLIC_APP_TAGLINE="From 'I need a doctor' to 'I know my next step.'"
# Canonical origin used for share links / QR codes. Defaults to the
# request origin in dev.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- AI provider (SERVER-ONLY secrets; never NEXT_PUBLIC_*) ----
# Options: mock | openai | anthropic | custom
AI_PROVIDER="mock"
# Single API key for the configured provider. Read ONLY on the server
# (API routes). Client code must never reference API keys.
# AI_API_KEY=""
# Model + optional override endpoint for custom gateways.
# AI_MODEL=""
# AI_BASE_URL=""

# ---- Database — Supabase/Postgres (SERVER-ONLY secrets) ----
# When unset, the app runs in demo mode (mock provider):
# seed data with identical shapes, "Mock connected" badges.
# Apply supabase/schema.sql, then set:
# SUPABASE_URL="https://xyzcompany.supabase.co"
# SUPABASE_ANON_KEY=""
# Service-role key is ONLY for server-side admin jobs. Never expose it.
# SUPABASE_SERVICE_ROLE_KEY=""
# Direct Postgres connection string (alternative to Supabase REST).
# DATABASE_URL=""
