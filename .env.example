# =====================================================================
# Nurtura AI — environment variables (Vercel-ready)
#
# Local: copy to .env.local (gitignored — never commit real keys).
# Vercel: paste the SAME keys into Project → Settings → Environment
# Variables (see README "Vercel deployment steps").
#
# Demo mode: leave everything commented and the app runs fully on
# local/mock data + deterministic navigation replies. No feature
# crashes without backend config.
#
# RULE: only NEXT_PUBLIC_ values ship to the browser. API keys and
# service-role keys MUST stay server-side (no NEXT_PUBLIC_ prefix).
# =====================================================================

# ---- Supabase (public-safe: anon key is RLS-gated by design) ----
# Primary names. When BOTH are set, the app reports "Supabase connected".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy server-side fallbacks (accepted, not required):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER-ONLY, admin jobs only.
# NEVER add a NEXT_PUBLIC_ prefix. This repo never reads it; management
# scripts would use it exclusively from secure server contexts.
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (alternative to Supabase REST).
# Server-only. Leave unset for demo mode.
# DATABASE_URL=""

# ---- AI provider (ALL server-only; read only in API routes) ----
# Options: mock | openai | anthropic | custom
AI_PROVIDER="mock"
# Single API key for the configured provider. No client module may
# reference this — POST /api/assist and POST /api/navigate resolve it.
# AI_API_KEY=""
# Model + optional override endpoint for custom gateways.
# AI_MODEL=""
# AI_BASE_URL=""

# ---- App (public; safe for the browser) ----
NEXT_PUBLIC_APP_NAME="Nurtura AI"
NEXT_PUBLIC_APP_TAGLINE="From 'I need a doctor' to 'I know my next step.'"
# Canonical origin used for share links / QR codes. Defaults to the
# request origin when unset (recommended for Vercel preview deploys).
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
